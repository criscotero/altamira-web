{
  "name": "altamira-web-sanity",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "@altamira/web": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    },
    "@altamira/studio": {
      "react": "19.2.4",
      "react-dom": "19.2.4"
    }
  },
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:studio": "cd apps/studio && npm run dev -- --port 3333",
    "dev": "npm run dev:web & npm run dev:studio",

    "build:web": "cd apps/web && npm run build",
    "build:studio": "cd apps/studio && npm run build",
    "build": "npm run build:web && npm run build:studio",

    "lint": "cd apps/web && npm run lint",
    "typecheck": "cd apps/web && npm run typecheck"
  }
}
